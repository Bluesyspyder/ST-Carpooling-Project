# Backend API base URL
VITE_API_URL=http://localhost:5000/api/v1

# Mapbox public token (starts with pk.)
# Required for: address autocomplete, reverse geocoding, Mapbox routing fallback
VITE_MAPBOX_TOKEN=

# OpenRouteService API key
# Required for: primary route calculation (ORS → Mapbox fallback)
VITE_ORS_API_KEY=
